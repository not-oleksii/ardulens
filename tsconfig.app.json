{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Strictness (was packages/core's tsconfig.json, preserved for the merged src) */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  /* Storybook story/doc files are compiled by Storybook's own Vite/esbuild toolchain (see
     .storybook/main.ts), not by this project's tsc -b build - they don't ship in `vite build`'s
     output, so there's no reason to hold them to this project's own strict build. (A real OOM was
     hit adding the first batch of *.stories.tsx files, but confirmed via NODE_OPTIONS=
     --max-old-space-size to be this constrained machine's available memory, not a story-file-
     specific type-inference bug - this exclusion is kept anyway as the right scope, not as the
     fix for that.) */
  "exclude": ["src/**/*.stories.tsx", "src/design-system/**"]
}
