{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArduLens",
  "version": "0.1.0",
  "identifier": "com.ardulens.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173/app/",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ArduLens",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_GENERATED_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/not-oleksii/ardulens/releases/latest/download/latest.json"
      ]
    }
  }
}
